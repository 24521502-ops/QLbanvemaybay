# --- 1. Ignore thư mục build sinh ra sau khi chạy code ---
target/
bin/
out/
*.class

# --- 2. Ignore cấu hình của IDE Eclipse ---
.classpath
.project
.settings/

# --- 3. Ignore cấu hình của IDE IntelliJ IDEA ---
.idea/
*.iml
*.iws

# --- 4. Ignore cấu hình của NetBeans (IDE bạn đang dùng) ---
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# --- 5. Ignore các file hệ điều hành sinh ra (Rác hệ thống) ---
.DS_Store
Thumbs.db

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files (Không đẩy các file đóng gói nặng lên Git)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs
hs_err_pid*
replay_pid*

.vs/
